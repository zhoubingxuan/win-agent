# Copy this file to .env and adjust as needed.
# Everything here is only the *initial* value - the Settings tab and the web
# terminal's /commands take over from there (and are saved to settings.json).

# --- Endpoint ---
# You usually do NOT need these: the agent ships with switchable profiles
# (local / ollama / cloud) and you pick one in the UI. Set them only to pin the
# endpoint before the first start.
# LM Studio:   http://127.0.0.1:1234/v1   (no key needed, "local" is fine)
# Ollama:      http://127.0.0.1:11434/v1
# OpenAI:      https://api.openai.com/v1  (model gpt-4o-mini)
# DeepSeek:    https://api.deepseek.com/v1 (model deepseek-chat)
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
AGENT_MODEL=glm-4.7-flash
OPENAI_API_KEY=local

# Maximum tool-calling steps per user turn.
AGENT_MAX_STEPS=12

# Interface + reply language: "en" or "zh" (default: zh).
# AGENT_LANGUAGE=zh

# Optional: override the base system prompt.
# AGENT_SYSTEM_PROMPT=

# Optional: which PowerShell binary to use (e.g. pwsh.exe for PowerShell 7).
# AGENT_POWERSHELL=powershell.exe

# Stream replies token by token (true/false, default true).
# AGENT_STREAM=true

# --- Context window ---
# Tokens to budget against. 0 = use the length the endpoint reports (LM Studio and
# Ollama are asked automatically). If a local model errors with "maximum context
# length", set this to the window the model is really loaded with.
# AGENT_CONTEXT_LIMIT=0

# --- Robustness on slow / flaky endpoints ---
# How long one LLM request may take (ms). Local models are slow to warm up.
# AGENT_REQUEST_TIMEOUT_MS=180000
# Retries for 429 / 5xx / network errors, with backoff (honours Retry-After).
# AGENT_MAX_RETRIES=2

# --- Web tool ---
# Search page the `web` tool queries. {q} is replaced by the query.
# AGENT_WEB_SEARCH_URL=https://www.bing.com/search?q={q}

# --- Web control panel ---
# Port for `npm run web` (the defaults can also be changed live in the UI).
# AGENT_WEB_PORT=8787

# Working directory the agent and terminal start in.
# AGENT_WORKDIR=

# Where all persisted data lives: settings.json, history.json, usage.json and
# conversations/. Default: ./data next to the agent.
# AGENT_DATA_DIR=D:\win-agent-data

# Where runtime settings are persisted (overrides AGENT_DATA_DIR for this one file).
# AGENT_SETTINGS_FILE=data/settings.json

# 记忆化 / memory: the conversation, the token totals and the filed-away
# conversations all live in AGENT_DATA_DIR. Turn remembering on/off in the UI
# (Settings -> Memory) or with /memory on|off in the web terminal.

